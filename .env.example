# Neon Postgres (Vercel tự gắn khi kết nối Neon qua Marketplace)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"
# Chuỗi ngẫu nhiên dài để ký cookie đăng nhập
AUTH_SECRET="doi-thanh-chuoi-ngau-nhien-dai"
# Vercel Blob (để trống khi chạy local -> lưu file vào UPLOAD_DIR)
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./data/uploads"
